rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /vehicles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'avilanikkojosef1@gmail.com' || 
        request.auth.token.email == 'seff.carrental31@gmail.com'
      );
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'avilanikkojosef1@gmail.com' || 
        request.auth.token.email == 'seff.carrental31@gmail.com'
      );
    }

    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'avilanikkojosef1@gmail.com' || 
        request.auth.token.email == 'seff.carrental31@gmail.com'
      );
    }
  }
}
